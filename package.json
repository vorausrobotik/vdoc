    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@voraus/assets": "^0.2.0",
    "@voraus/css": "^0.4.0",
    "@voraus/mui-theme": "^0.3.2",
    "@voraus/react": "^0.4.0",
